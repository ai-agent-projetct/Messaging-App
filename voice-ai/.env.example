# Copy this file to .env and fill in the values. Never commit .env.

# Port the server listens on.
PORT=3000

# ---------- AI ----------
# Your Anthropic API key (https://console.anthropic.com). Without it the
# product runs in free demo mode with placeholder answers.
ANTHROPIC_API_KEY=

# Optional: which Claude model answers calls, and how hard it thinks during
# live calls. Lower effort = faster replies, which matters on the phone.
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=low

# ---------- Phone calls & messages (Twilio) ----------
# Account SID + auth token from the Twilio console. The auth token is also
# used to verify that webhook requests really come from Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your server's public HTTPS address, exactly as entered in Twilio (no trailing slash).
PUBLIC_URL=https://your-domain.example
# Number that outbound campaign calls come from (a Twilio number you own).
TWILIO_CALLER_ID=
# Senders for customer follow-ups. WhatsApp needs an approved WhatsApp sender in Twilio.
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# ---------- Platform ----------
# Comma-separated emails of the VoiceDesk team; they see the Admin console.
ADMIN_EMAILS=
# Max sign-ups per network per hour (anti-abuse).
SIGNUP_RATE_LIMIT=10
# Set to 1 when running behind a load balancer / reverse proxy, so rate limits see real client IPs.
TRUST_PROXY=

# Where the JSON database file lives.
DATA_FILE=./data/db.json
