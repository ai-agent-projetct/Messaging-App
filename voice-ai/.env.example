# Copy this file to .env and fill in the values. Never commit .env.

# Port the server listens on.
PORT=3000

# Your Anthropic API key (https://console.anthropic.com). Without it the
# receptionist runs in free demo mode with placeholder answers.
ANTHROPIC_API_KEY=

# Optional: which Claude model answers calls, and how hard it thinks.
# Lower effort = faster replies, which matters on the phone.
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=low

# Twilio (phone calls). The auth token is used to check that webhook
# requests really come from Twilio. PUBLIC_URL is your server's public HTTPS
# address, exactly as entered in Twilio (no trailing slash).
TWILIO_AUTH_TOKEN=
PUBLIC_URL=https://your-domain.example

# Where the JSON database file lives.
DATA_FILE=./data/db.json
