# ---------- WhatsApp Cloud API (developers.facebook.com -> your app -> WhatsApp) ----------
# Business number: +91 93845 64915
WHATSAPP_TOKEN=                 # permanent System User token (Business Settings -> System users)
WHATSAPP_PHONE_NUMBER_ID=       # "Phone number ID" shown on WhatsApp -> API Setup (not the phone number)
WHATSAPP_APP_SECRET=            # App settings -> Basic -> App secret (verifies webhook signatures)
WHATSAPP_VERIFY_TOKEN=          # any long random string; paste the same in the Meta webhook settings
GRAPH_API_VERSION=v23.0

# ---------- AI ----------
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium                # low | medium | high

# ---------- Database ----------
# Local testing: sqlite. Production: postgresql+psycopg://user:pass@host:5432/ithrive
DATABASE_URL=sqlite:///./data/ithrive.db

# ---------- Admin dashboard (http://your-server/admin) ----------
ADMIN_USER=admin
ADMIN_PASSWORD=                 # required, use a strong password

# ---------- Sales team alerts ----------
SALES_WHATSAPP=                 # sales person's WhatsApp number, e.g. 919xxxxxxxxx (optional)
N8N_WEBHOOK_URL=                # n8n / Zapier / CRM webhook that receives lead events as JSON (optional)

# ---------- Follow-ups ----------
FOLLOWUP_HOURS=4,22,72          # hours after our last message, only if the client went quiet
FOLLOWUP_TEMPLATE=              # approved template name for follow-ups after 24h (empty = no follow-up after 24h)
TEMPLATE_LANGUAGE=en
QUIET_HOURS=21-9                # no follow-ups between 9pm and 9am IST
TIMEZONE=Asia/Kolkata

# ---------- Privacy ----------
DATA_RETENTION_DAYS=365         # delete conversation messages older than this

# Set to 1 to log outgoing WhatsApp messages instead of sending them
DRY_RUN=0
