# ---- WhatsApp Cloud API (Meta for Developers -> your app -> WhatsApp -> API Setup) ----
# Permanent access token from a System User in Meta Business Settings (not the 24h test token)
WHATSAPP_TOKEN=
# "Phone number ID" of +91 93845 64915 (NOT the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=
# App secret (App settings -> Basic). Used to verify that webhooks really come from Meta.
WHATSAPP_APP_SECRET=
# Any random string; paste the same value into the webhook "Verify token" field in Meta
WHATSAPP_VERIFY_TOKEN=
GRAPH_API_VERSION=v23.0

# ---- Claude ----
ANTHROPIC_API_KEY=

# ---- Server ----
PORT=3000
# Protects the /admin endpoints. Use a long random string.
ADMIN_TOKEN=
# Where leads and conversations are stored
DATA_FILE=./data/leads.json
# Set to 1 to log outgoing messages instead of sending them (safe testing)
DRY_RUN=0
